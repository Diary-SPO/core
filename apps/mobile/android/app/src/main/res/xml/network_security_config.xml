<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Дневник возвращает redirect_uri со схемой http, ЕСИА редиректит
         WebView на http://<diary>/services/esia/login?code=... -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
