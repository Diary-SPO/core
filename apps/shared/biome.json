{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": ["**", "!**/node_modules", "!**/yarn.lock", "!**/.github"]
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
