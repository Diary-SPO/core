---
import Callout from '../../components/Callout.astro'
import DownloadCta from '../../components/DownloadCta.astro'
import Layout from '../../layouts/Layout.astro'
import { LINKS } from '../../config'
import { withBase } from '../../lib/site'

const path = 'skachat/'
---

<Layout
  title="Скачать Дневник СПО — приложение для колледжа на Android (APK и RuStore)"
  description="Скачайте Дневник СПО бесплатно: установка через RuStore или APK файл. Требуется Android 8+. Автоматические обновления. Поддержка студентов колледжей и техникумов."
  path={path}
>
  <h1>Скачать Дневник СПО на Android</h1>
  <p class="seo-lead">
    Два способа установки. Сверху — быстрый старт, ниже — детали и что делать,
    если не ставится.
  </p>

  <DownloadCta
    title="Установить Дневник СПО"
    lead="Бесплатно · Android 8+ · без рекламы"
    showGuideLinks={false}
  />

  <div class="seo-split" style="margin-top: 1.75rem">
    <div class="seo-split-card">
      <h3>RuStore</h3>
      <ol>
        <li>Откройте RuStore</li>
        <li>Найдите «Дневник СПО»</li>
        <li>Пакет io.github.diaryspo</li>
        <li>Нажмите «Установить»</li>
      </ol>
      <p>
        Обновления приходят сами.
        <a href={LINKS.rustore} target="_blank" rel="noreferrer">Открыть в RuStore</a>
      </p>
    </div>
    <div class="seo-split-card">
      <h3>APK с сайта</h3>
      <ol>
        <li><a href={LINKS.apk}>Скачайте APK</a></li>
        <li>Откройте файл</li>
        <li>Разрешите установку из браузера (один раз)</li>
        <li>Нажмите «Установить»</li>
      </ol>
      <p>Новая версия ставится поверх старой — удалять не нужно.</p>
    </div>
  </div>

  <Callout variant="info" title="Требования">
    <p>Android 8.0+ и ARM-процессор (почти все современные смартфоны).</p>
  </Callout>

  <Callout variant="tip" title="Не устанавливается APK?">
    <ul>
      <li>Проверьте версию Android (настройки → о телефоне)</li>
      <li>Разрешите неизвестные источники / установку из браузера</li>
      <li>Скачайте файл заново — мог битый докачаться</li>
    </ul>
  </Callout>

  <Callout variant="ok" title="После установки">
    <p>
      Дальше: <a href={withBase('vhod/')}>как войти</a> или
      <a href={withBase('vhod-cherez-gosuslugi/')}>вход через Госуслуги</a>.
      Список регионов — <a href={withBase('regions/')}>здесь</a>.
    </p>
  </Callout>
</Layout>
