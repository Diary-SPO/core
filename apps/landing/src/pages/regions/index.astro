---
import Callout from '../../components/Callout.astro'
import DownloadCta from '../../components/DownloadCta.astro'
import Layout from '../../layouts/Layout.astro'
import {
  regionEmblemUrl,
  regionThumbUrl
} from '../../lib/region-media'
import { REGIONS } from '../../lib/regions'
import { withBase } from '../../lib/site'

const path = 'regions/'
const sorted = [...REGIONS].sort((a, b) =>
  a.name.localeCompare(b.name, 'ru', { sensitivity: 'base' })
)
---

<Layout
  title="Регионы Дневник СПО — приложение для Сетевого города по субъектам"
  description="Где работает неофициальное приложение Дневник СПО: регионы модуля ПОО «Сетевой город. Образование». Челябинск, Калуга, Сыктывкар, Томск и другие — скачать клиент на Android."
  path={path}
>
  <h1>Регионы приложения Дневник СПО</h1>
  <p class="seo-lead">
    Дневник СПО — не сам «Сетевой город», а неофициальный Android-клиент к нему.
    Ниже субъекты, где модуль ПОО поддерживается: откройте свой регион — там
    про вход и частые проблемы. Если искали дневник по городу или коду субъекта
    — сверьте список.
  </p>

  <ul class="seo-regions">
    {
      sorted.map((region) => (
        <li>
          <a
            class="seo-region-card"
            href={withBase(`dnevnik-spo-${region.code}/`)}
            style={`--region-photo: url('${regionThumbUrl(region.id)}')`}
          >
            <img
              class="seo-region-emblem"
              src={regionEmblemUrl(region.id)}
              alt=""
              width="48"
              height="48"
              loading="lazy"
            />
            <span>
              <strong>{region.name}</strong>
              <small>{new URL(region.url).hostname}</small>
            </span>
            {region.hasEsiaOnly && (
              <span class="seo-region-badge">только Госуслуги</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  <Callout variant="warn" title="Региона нет в списке?">
    <p>Чаще всего так:</p>
    <ul>
      <li>Регион на другой системе, не «Сетевой город. Образование»</li>
      <li>Есть «Сетевой город», но только для школ, не для СПО</li>
    </ul>
    <p>Уточните систему в учебной части колледжа.</p>
  </Callout>

  <Callout variant="info" title="Школьникам не подойдёт">
    <p>
      Школьный модуль отключён с 1 сентября 2026 — школы на «Госуслуги. Моя
      школа». Дневник СПО только для студентов колледжей и техникумов.
    </p>
  </Callout>

  <DownloadCta />
</Layout>
