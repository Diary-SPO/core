---
import Callout from '../../components/Callout.astro'
import CauseCard from '../../components/CauseCard.astro'
import DownloadCta from '../../components/DownloadCta.astro'
import Layout from '../../layouts/Layout.astro'
import { withBase } from '../../lib/site'

const path = 'dnevnik-spo-ne-rabotaet/'
---

<Layout
  title="Не работает Сетевой город в Дневнике СПО — причины"
  description="Не работает Сетевой город или Дневник СПО? Разбираем реальные причины: работы на портале, переход на ЕСИА, другая система в регионе, проблемы с интернетом."
  path={path}
>
  <h1>Не работает Сетевой город в Дневнике СПО</h1>
  <p class="seo-lead">
    Данные не грузятся, ошибки, расписание не обновляется — обычно дело в
    портале, ЕСИА или интернете.
  </p>

  <div class="seo-causes">
    <CauseCard n={1} title="Технические работы на портале">
      <p>Чаще всего виноват региональный оператор, не приложение.</p>
      <ul>
        <li>Проверьте дневник в браузере</li>
        <li>Если портал лежит — подождите или спросите в учебной части</li>
      </ul>
    </CauseCard>

    <CauseCard n={2} title="Регион перешёл на ЕСИА">
      <p>Логин-пароль могли отключить.</p>
      <ul>
        <li>Смотрите способ входа на портале</li>
        <li>В приложении — «Войти через Госуслуги»</li>
        <li>Учётная запись Госуслуг должна быть подтверждена</li>
      </ul>
    </CauseCard>

    <CauseCard n={3} title="Другая система в регионе">
      <p>
        Не везде СПО на «Сетевом городе» (например, БАРС в Тюменской области).
        Тогда Дневник СПО не подойдёт.
      </p>
    </CauseCard>

    <CauseCard n={4} title="Интернет">
      <p>Нужна стабильная связь с порталом — смените Wi-Fi ↔ мобильный.</p>
    </CauseCard>

    <CauseCard n={5} title="Неверный регион">
      <p>В настройках должен быть ваш регион — иначе запросы идут мимо.</p>
    </CauseCard>

    <CauseCard n={6} title="Старая версия приложения">
      <p>Обновите в RuStore или поставьте свежий APK с сайта.</p>
    </CauseCard>
  </div>

  <Callout variant="warn" title="Когда это не приложение">
    <p>
      Если и в браузере дневник не открывается — пишите оператору портала или в
      учебную часть. Клиент только показывает данные с портала.
    </p>
  </Callout>

  <Callout variant="tip" title="Браузер ок, приложение нет">
    <p>
      Пишите в <a href="https://vk.com/diary_spo">vk.com/diary_spo</a>: регион,
      версия приложения и что именно ломается.
    </p>
  </Callout>

  <div class="seo-related">
    <a href={withBase('vhod/')}>Как войти</a>
    <a href={withBase('vhod-cherez-gosuslugi/')}>Госуслуги</a>
    <a href={withBase('dnevnik-spo-ne-otkryvaetsya/')}>Не открывается</a>
    <a href={withBase('dnevnik-spo-oshibka-zaprosa/')}>Ошибка запроса</a>
  </div>

  <DownloadCta />
</Layout>
