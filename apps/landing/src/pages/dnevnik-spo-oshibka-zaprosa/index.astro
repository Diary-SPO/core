---
import Callout from '../../components/Callout.astro'
import CauseCard from '../../components/CauseCard.astro'
import DownloadCta from '../../components/DownloadCta.astro'
import Layout from '../../layouts/Layout.astro'
import { withBase } from '../../lib/site'

const path = 'dnevnik-spo-oshibka-zaprosa/'
---

<Layout
  title="Ошибка запроса в Дневнике СПО при входе — решение"
  description="Появляется «ошибка запроса» после ввода пароля в Дневнике СПО? Разбираем причины: неверный пароль, блокировка аккаунта, переход на ЕСИА, работы на портале."
  path={path}
>
  <h1>Ошибка запроса в Дневнике СПО — что делать</h1>
  <p class="seo-lead">
    Сообщение об ошибке после логина и пароля? Пройдите причины сверху вниз —
    чаще всего это пароль или переход региона на Госуслуги.
  </p>

  <div class="seo-causes">
    <CauseCard n={1} title="Неверный логин или пароль">
      <p>Пароль должен совпадать с тем, что на портале в браузере.</p>
      <ul>
        <li>Проверьте раскладку и Caps Lock</li>
        <li>Введите данные заново</li>
        <li>Если забыли пароль — только учебная часть или портал оператора</li>
      </ul>
    </CauseCard>

    <CauseCard n={2} title="Регион перешёл на ЕСИА">
      <p>Логин-пароль могли отключить — остался вход через Госуслуги.</p>
      <ul>
        <li>Проверьте способ входа на портале региона</li>
        <li>В приложении нажмите «Войти через Госуслуги»</li>
        <li>Нужна подтверждённая учётная запись</li>
      </ul>
    </CauseCard>

    <CauseCard n={3} title="Аккаунт заблокирован">
      <p>Несколько неверных попыток — временная блокировка на портале.</p>
      <ul>
        <li>Подождите 15–30 минут</li>
        <li>Попробуйте снова</li>
        <li>Если не снимается — в учебную часть</li>
      </ul>
    </CauseCard>

    <CauseCard n={4} title="Работы на портале">
      <p>Портал может отдавать ошибки и в браузере.</p>
      <ul>
        <li>Проверьте вход через браузер</li>
        <li>Если там тоже ошибка — ждите окончания работ</li>
      </ul>
    </CauseCard>

    <CauseCard n={5} title="Устаревшая версия">
      <p>Обновите приложение в RuStore или скачайте свежий APK.</p>
    </CauseCard>

    <CauseCard n={6} title="Неверный регион">
      <p>Запрос уходит не на тот портал — смените регион в настройках.</p>
    </CauseCard>
  </div>

  <Callout variant="warn" title="Если ошибка и в браузере">
    <p>
      Это сторона портала, не приложения. Пишите в учебную часть или поддержку
      регионального дневника.
    </p>
  </Callout>

  <Callout variant="tip" title="Портал в браузере работает, приложение — нет">
    <p>
      Напишите в <a href="https://vk.com/diary_spo">vk.com/diary_spo</a>: регион,
      текст ошибки, версия приложения и что вход через браузер ок.
    </p>
  </Callout>

  <div class="seo-related">
    <a href={withBase('vhod/')}>Как войти</a>
    <a href={withBase('vhod-cherez-gosuslugi/')}>Госуслуги</a>
    <a href={withBase('dnevnik-spo-ne-otkryvaetsya/')}>Не открывается</a>
    <a href={withBase('dnevnik-spo-ne-rabotaet/')}>Не работает</a>
  </div>

  <DownloadCta />
</Layout>
