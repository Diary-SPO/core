---
import { LINKS } from '../config'
import { publicUrl, withBase } from '../lib/site'

interface Props {
  title?: string
  lead?: string
  showGuideLinks?: boolean
}

const {
  title = 'Скачать Дневник СПО',
  lead = 'Неофициальное приложение для Android: расписание и оценки с вашего регионального дневника. Бесплатно, без рекламы.',
  showGuideLinks = true
} = Astro.props

const icon = publicUrl('icon.png')
const rustore = publicUrl('rustore.svg')
---

<section class="seo-download" aria-label="Скачать приложение">
  <div class="download-card">
    <div>
      <h2>{title}</h2>
      <p>{lead}</p>
      <div class="cta">
        <a
          class="btn btn-primary btn-lg"
          href={LINKS.rustore}
          target="_blank"
          rel="noreferrer"
        >
          <img class="btn-icon" src={rustore} alt="" aria-hidden="true" />
          RuStore
        </a>
        <a class="btn btn-lg" href={LINKS.apk}> APK напрямую </a>
      </div>
      {
        showGuideLinks && (
          <p class="seo-download-links">
            <a href={withBase('vhod/')}>Как войти</a>
            {' · '}
            <a href={withBase('vhod-cherez-gosuslugi/')}>Госуслуги</a>
            {' · '}
            <a href={withBase('o-proekte/')}>О проекте</a>
            {' · '}
            <a href={withBase('skachat/')}>Подробнее об установке</a>
          </p>
        )
      }
    </div>
    <img
      class="download-icon"
      src={icon}
      alt="Иконка приложения Дневник СПО"
      loading="lazy"
      width="128"
      height="128"
    />
  </div>
  <p class="hint seo-download-hint">
    Нет RuStore — ставьте APK. Разрешите установку из браузера один раз.
  </p>
</section>
