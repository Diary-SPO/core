---
import Callout from './Callout.astro'
import DownloadCta from './DownloadCta.astro'
import Layout from '../layouts/Layout.astro'
import { getRegionPageContent } from '../lib/region-content'
import { regionEmblemUrl, regionPhotoUrl } from '../lib/region-media'
import type { DiaryRegion } from '../lib/regions'
import {
  citiesVisibleCount,
  pluralCitiesMore,
  regionCities,
  regionCodeWithName,
  regionSearchPhrases,
  regionSeoDescription,
  regionSeoH1,
  regionSeoTitle,
  spoCodeWithName
} from '../lib/region-seo'
import { withBase } from '../lib/site'

interface Props {
  region: DiaryRegion
}

const { region } = Astro.props
const host = new URL(region.url).hostname
const emblem = regionEmblemUrl(region.id)
const photo = regionPhotoUrl(region.id)
const cities = regionCities(region)
const citiesShown = citiesVisibleCount(cities.length)
const citiesPreview = cities.slice(0, citiesShown)
const citiesRest = cities.slice(citiesShown)
const content = getRegionPageContent(region)
const searchPhrases = [
  ...new Set([...regionSearchPhrases(region), ...content.searchExtra])
]
const codeLabel = regionCodeWithName(region)
const spoLabel = spoCodeWithName(region)
const cityList =
  cities.length > 0
    ? cities.length === 1
      ? cities[0]
      : cities.length <= 3
        ? `${cities.slice(0, -1).join(', ')} и ${cities[cities.length - 1]}`
        : `${cities.slice(0, 3).join(', ')} и другие`
    : null

const path = `dnevnik-spo-${region.code}/`
const title = regionSeoTitle(region)
const description = regionSeoDescription(region)
const h1 = regionSeoH1(region)
const faqMain = content.faq

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqMain.map((item) => ({
    '@type': 'Question',
    name: item.name,
    acceptedAnswer: { '@type': 'Answer', text: item.text }
  }))
}
---

<Layout
  title={title}
  description={description}
  path={path}
  ogImage={photo}
  jsonLd={jsonLd}
>
  <a class="seo-back" href={withBase('regions/')}>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M15 6 9 12l6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Все регионы
  </a>

  <section
    class="region-hero"
    style={`--region-photo: url('${photo}')`}
    aria-label={region.name}
  >
    <div class="region-hero-bg" aria-hidden="true"></div>
    <div class="region-hero-in">
      <img
        class="region-hero-emblem"
        src={emblem}
        alt={`Герб: ${region.name}`}
        width="84"
        height="84"
      />
      <div>
        <p class="region-hero-kicker">{spoLabel}</p>
        <h1>{h1}</h1>
        <p class="region-hero-lead">
          {content.systemName}
          {cityList ? ` — ${cityList}` : ''}
        </p>
      </div>
      <div class="region-hero-meta">
        <span class="region-hero-chip">код {codeLabel}</span>
        <a
          class="region-hero-chip"
          href={region.url}
          target="_blank"
          rel="noreferrer">{host}</a
        >
        {
          region.hasEsiaOnly && (
            <span class="region-hero-chip">вход через Госуслуги</span>
          )
        }
      </div>
    </div>
  </section>

  <article class="region-article">
    {content.article.map((paragraph) => <p>{paragraph}</p>)}
  </article>

  <p class="seo-portal">
    Официальный портал:
    <a href={region.url} target="_blank" rel="noreferrer">{region.url}</a>
  </p>

  {
    cities.length > 0 && (
      <section class="region-cities-block" aria-label="Города региона">
        <h2 class="seo-block-title">Города региона</h2>
        <p>
          Электронный дневник СПО в регионе «{region.name}» используют студенты
          колледжей и техникумов, в том числе в этих городах:
        </p>
        <ul class="region-cities">
          {citiesPreview.map((city) => (
            <li>{city}</li>
          ))}
        </ul>
        {citiesRest.length > 0 && (
          <details class="region-cities-more">
            <summary>Ещё {pluralCitiesMore(citiesRest.length)}</summary>
            <ul class="region-cities">
              {citiesRest.map((city) => (
                <li>{city}</li>
              ))}
            </ul>
          </details>
        )}
      </section>
    )
  }

  {content.notes.map((note) => (
    <Callout variant={note.variant} title={note.title}>
      <p>{note.text}</p>
    </Callout>
  ))}

  <h2 class="seo-block-title">Как войти</h2>
  <p>{content.loginHint}</p>
  <ol class="seo-steps">
    <li class="seo-step">
      <span class="seo-step-n">1</span>
      <div>
        <h3>Откройте сайт {host}</h3>
        <p>
          Убедитесь, что это портал именно вашего региона «{region.name}», а не
          школьный дневник и не сайт другого субъекта.
        </p>
      </div>
    </li>
    <li class="seo-step">
      <span class="seo-step-n">2</span>
      <div>
        <h3>Войдите удобным способом</h3>
        <div class="seo-split">
          <div class="seo-split-card">
            <h3>Логин и пароль</h3>
            <p>
              Те же данные, что выдала учебная часть вашего колледжа. Если
              забыли пароль — придётся обратиться в учебную часть: только там
              могут восстановить доступ.
            </p>
          </div>
          <div class="seo-split-card">
            <h3>Госуслуги</h3>
            <p>
              Если регион перешёл на ЕСИА, нажмите «Войти через Госуслуги».
              Учётная запись на Госуслугах должна быть подтверждена — иначе
              система не пустит.
            </p>
          </div>
        </div>
      </div>
    </li>
    <li class="seo-step">
      <span class="seo-step-n">3</span>
      <div>
        <h3>Готово</h3>
        <p>
          После входа откроются расписание, оценки, задания и объявления вашего
          учебного заведения.
        </p>
      </div>
    </li>
  </ol>

  <h2 class="seo-block-title">Типичные проблемы в этом регионе</h2>
  <div class="seo-faq">
    {
      content.problems.map((item) => (
        <div class="seo-faq-item">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))
    }
  </div>

  <p>Полезные статьи:</p>
  <div class="seo-related">
    <a href={withBase('vhod/')}>Как войти</a>
    <a href={withBase('zabyl-parol/')}>Забыли пароль</a>
    <a href={withBase('privyazka-gosuslug/')}>Привязка Госуслуг</a>
    <a href={withBase('dnevnik-spo-ne-otkryvaetsya/')}>Не открывается</a>
    <a href={withBase('dnevnik-spo-oshibka-zaprosa/')}>Ошибка запроса</a>
    <a href={withBase('dnevnik-spo-ne-rabotaet/')}>Не работает</a>
  </div>

  <h2 class="seo-block-title">Частые вопросы</h2>
  <div class="seo-faq">
    {
      faqMain.map((item) => (
        <div class="seo-faq-item">
          <h3>{item.name}</h3>
          <p>{item.text}</p>
        </div>
      ))
    }
  </div>

  <h2 class="seo-block-title">Как ещё ищут дневник в этом регионе</h2>
  <ul class="seo-search-phrases">
    {searchPhrases.map((phrase) => <li>{phrase}</li>)}
  </ul>

  <h2 class="seo-block-title">Приложение Дневник СПО</h2>
  <p>
    Если удобнее смотреть тот же дневник на телефоне, есть приложение
    <strong>Дневник СПО</strong>. Оно неофициальное: подключается к порталу{' '}
    {host} и показывает расписание и оценки для региона «{region.name}». Это не
    сам Сетевой город и не продукт его оператора — просто клиент под Android.
  </p>

  <DownloadCta
    title="Скачать Дневник СПО"
    lead={`Поддерживается регион «${region.name}». Установка через RuStore или APK.`}
  />
</Layout>

<style>
  .seo-block-title {
    margin: 1.75rem 0 0.75rem !important;
    font-size: 1.2rem !important;
  }

  .region-article {
    margin: 1.25rem 0 1rem;
  }

  .region-article p {
    margin: 0 0 0.9rem;
    line-height: 1.65;
    color: var(--seo-text, inherit);
  }

  .region-article p:last-child {
    margin-bottom: 0;
  }
</style>
