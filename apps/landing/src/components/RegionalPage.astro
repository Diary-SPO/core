---
import Callout from './Callout.astro'
import DownloadCta from './DownloadCta.astro'
import Layout from '../layouts/Layout.astro'
import { CONTENT_VARIANTS, pickVariant } from '../lib/content-variants'
import {
  regionEmblemUrl,
  regionPhotoUrl
} from '../lib/region-media'
import type { DiaryRegion } from '../lib/regions'
import { withBase } from '../lib/site'

interface Props {
  region: DiaryRegion
}

const { region } = Astro.props
const host = new URL(region.url).hostname
const emblem = regionEmblemUrl(region.id)
const photo = regionPhotoUrl(region.id)

const intro = pickVariant(CONTENT_VARIANTS.intro, region.code)
const whatIs = pickVariant(CONTENT_VARIANTS.whatIs, region.code + 'what')
const howToEnter = pickVariant(CONTENT_VARIANTS.howToEnter, region.code + 'how')
const ifNotOpens = pickVariant(CONTENT_VARIANTS.ifNotOpens, region.code + 'open')

const schoolQuestion = pickVariant(
  CONTENT_VARIANTS.faq.schoolQuestion,
  region.code + 'sq'
)
const schoolAnswer = pickVariant(
  CONTENT_VARIANTS.faq.schoolAnswer,
  region.code + 'sa'
)
const passwordQuestion = pickVariant(
  CONTENT_VARIANTS.faq.passwordQuestion,
  region.code + 'pq'
)
const passwordAnswer = pickVariant(
  CONTENT_VARIANTS.faq.passwordAnswer,
  region.code + 'pa'
)
const esiaQuestion = pickVariant(
  CONTENT_VARIANTS.faq.esiaQuestion,
  region.code + 'eq'
)

const cities = region.aliases.filter((a) => /[а-яё]/i.test(a))
const path = `dnevnik-spo-${region.code}/`
const title = `Дневник СПО — ${region.name}: электронный дневник колледжа`
const description = `Дневник СПО для студентов колледжей и техникумов: ${region.name}. Расписание, оценки и задания на Android. Портал ${host}. Вход по логину или через Госуслуги.`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: schoolQuestion,
      acceptedAnswer: { '@type': 'Answer', text: schoolAnswer }
    },
    {
      '@type': 'Question',
      name: passwordQuestion,
      acceptedAnswer: { '@type': 'Answer', text: passwordAnswer }
    },
    ...(region.hasEsiaOnly
      ? [
          {
            '@type': 'Question',
            name: esiaQuestion,
            acceptedAnswer: {
              '@type': 'Answer',
              text:
                region.note ||
                'Это требование регионального оператора, не приложения.'
            }
          }
        ]
      : [])
  ]
}
---

<Layout
  title={title}
  description={description}
  path={path}
  ogImage={photo}
  jsonLd={jsonLd}
>
  <a class="seo-back" href={withBase('regions/')}>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M15 6 9 12l6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Все регионы
  </a>

  <section
    class="region-hero"
    style={`--region-photo: url('${photo}')`}
    aria-label={region.name}
  >
    <div class="region-hero-bg" aria-hidden="true"></div>
    <div class="region-hero-in">
      <img
        class="region-hero-emblem"
        src={emblem}
        alt={`Герб: ${region.name}`}
        width="84"
        height="84"
      />
      <div>
        <h1>Дневник СПО — {region.name}</h1>
        <p class="region-hero-lead">{intro}</p>
      </div>
      <div class="region-hero-meta">
        <a class="region-hero-chip" href={region.url} target="_blank" rel="noreferrer"
          >{host}</a
        >
        {
          region.hasEsiaOnly && (
            <span class="region-hero-chip">только Госуслуги</span>
          )
        }
        {
          cities.slice(0, 3).map((city) => (
            <span class="region-hero-chip">{city}</span>
          ))
        }
      </div>
    </div>
  </section>

  <p class="seo-lead">{whatIs}</p>

  {
    region.hasEsiaOnly && (
      <Callout variant="warn" title="Важно для этого региона">
        <p>{region.note}</p>
      </Callout>
    )
  }

  <Callout variant="info" title="Что показывает приложение">
    <p>
      Расписание, оценки, задания и объявления из официального портала «{
        region.name
      }» — в удобном виде на телефоне.
    </p>
  </Callout>

  <h2 class="seo-block-title">Как войти</h2>
  <ol class="seo-steps">
    <li class="seo-step">
      <span class="seo-step-n">1</span>
      <div>
        <h3>Выберите «{region.name}»</h3>
        <p>В списке регионов при первом запуске.</p>
      </div>
    </li>
    <li class="seo-step">
      <span class="seo-step-n">2</span>
      <div>
        <h3>Логин или Госуслуги</h3>
        <p>{howToEnter}</p>
      </div>
    </li>
    <li class="seo-step">
      <span class="seo-step-n">3</span>
      <div>
        <h3>Готово</h3>
        <p>Расписание и оценки перед вами.</p>
      </div>
    </li>
  </ol>

  <Callout variant="ok" title="Пароль не хранится в приложении">
    <p>
      Данные уходят напрямую в региональный дневник. Исходный код открыт на
      GitHub.
    </p>
  </Callout>

  <h2 class="seo-block-title">Если дневник не открывается</h2>
  <div class="seo-faq">
    <div class="seo-faq-item">
      <h3>Работы на портале</h3>
      <p>{ifNotOpens}</p>
    </div>
    <div class="seo-faq-item">
      <h3>Неверный регион</h3>
      <p>
        Должна быть выбрана именно «{region.name}» — иначе запросы уйдут на
        другой портал.
      </p>
    </div>
    <div class="seo-faq-item">
      <h3>Переход на ЕСИА</h3>
      <p>
        Используйте «Войти через Госуслуги». Подробнее:
        <a href={withBase('vhod-cherez-gosuslugi/')}>инструкция</a>.
      </p>
    </div>
  </div>

  <div class="seo-related">
    <a href={withBase('dnevnik-spo-ne-otkryvaetsya/')}>Не открывается</a>
    <a href={withBase('dnevnik-spo-oshibka-zaprosa/')}>Ошибка запроса</a>
    <a href={withBase('dnevnik-spo-ne-rabotaet/')}>Не работает</a>
    <a href={withBase('regions/')}>Все регионы</a>
  </div>

  <h2 class="seo-block-title">Частые вопросы</h2>
  <div class="seo-faq">
    <div class="seo-faq-item">
      <h3>{schoolQuestion}</h3>
      <p>{schoolAnswer}</p>
    </div>
    <div class="seo-faq-item">
      <h3>{passwordQuestion}</h3>
      <p>{passwordAnswer}</p>
    </div>
    {
      region.hasEsiaOnly && (
        <div class="seo-faq-item">
          <h3>{esiaQuestion}</h3>
          <p>
            {region.note} Это требование регионального оператора, не приложения.
          </p>
        </div>
      )
    }
    <div class="seo-faq-item">
      <h3>Адрес портала «{region.name}»?</h3>
      <p>
        При выборе региона подключается автоматически:
        <a href={region.url}>{region.url}</a>
        {
          cities.length > 0 && (
            <>
              . Часто ищут по городам: {cities.join(', ')}.
            </>
          )
        }
      </p>
    </div>
  </div>

  <DownloadCta
    title={`Скачать Дневник СПО для региона «${region.name}»`}
    lead="Android · бесплатно. Дальше выберите регион в приложении."
  />
</Layout>

<style>
  .seo-block-title {
    margin: 1.75rem 0 0.75rem !important;
    font-size: 1.2rem !important;
  }
</style>
