---
import Callout from './Callout.astro'
import DownloadCta from './DownloadCta.astro'
import Layout from '../layouts/Layout.astro'
import { CONTENT_VARIANTS, pickVariant } from '../lib/content-variants'
import { regionEmblemUrl, regionPhotoUrl } from '../lib/region-media'
import type { DiaryRegion } from '../lib/regions'
import {
  regionCities,
  regionCodeWithName,
  regionSearchPhrases,
  regionSeoDescription,
  regionSeoH1,
  regionSeoTitle,
  spoCodeWithName
} from '../lib/region-seo'
import { withBase } from '../lib/site'

interface Props {
  region: DiaryRegion
}

const { region } = Astro.props
const host = new URL(region.url).hostname
const emblem = regionEmblemUrl(region.id)
const photo = regionPhotoUrl(region.id)
const cities = regionCities(region)
const searchPhrases = regionSearchPhrases(region)
const mainCity = cities[0]
const codeLabel = regionCodeWithName(region)
const spoLabel = spoCodeWithName(region)

const intro = pickVariant(CONTENT_VARIANTS.intro, region.code)
const whatIs = pickVariant(CONTENT_VARIANTS.whatIs, region.code + 'what')
const howToEnter = pickVariant(CONTENT_VARIANTS.howToEnter, region.code + 'how')
const ifNotOpens = pickVariant(CONTENT_VARIANTS.ifNotOpens, region.code + 'open')

const schoolQuestion = pickVariant(
  CONTENT_VARIANTS.faq.schoolQuestion,
  region.code + 'sq'
)
const schoolAnswer = pickVariant(
  CONTENT_VARIANTS.faq.schoolAnswer,
  region.code + 'sa'
)
const passwordQuestion = pickVariant(
  CONTENT_VARIANTS.faq.passwordQuestion,
  region.code + 'pq'
)
const passwordAnswer = pickVariant(
  CONTENT_VARIANTS.faq.passwordAnswer,
  region.code + 'pa'
)
const esiaQuestion = pickVariant(
  CONTENT_VARIANTS.faq.esiaQuestion,
  region.code + 'eq'
)

const path = `dnevnik-spo-${region.code}/`
const title = regionSeoTitle(region)
const description = regionSeoDescription(region)
const h1 = regionSeoH1(region)

const faqMain = [
  {
    name: `Дневник СПО — это и есть «Сетевой город» ${mainCity || region.name}?`,
    text:
      `Нет. «Сетевой город. Образование» — официальная региональная система ` +
      `(портал ${host}). Дневник СПО — независимое неофициальное приложение: ` +
      `оно подключается к этому порталу и показывает расписание и оценки на Android` +
      (mainCity ? ` для студентов из ${cities.slice(0, 3).join(', ')} и региона` : '') +
      `. Мы не оператор дневника и не связаны с АО «ИРТех».`
  },
  {
    name: `Подойдёт ли, если искал «электронный дневник СПО ${codeLabel}»?`,
    text:
      `Да, если ваш колледж в «${region.name}» (код ${region.code}) работает на ` +
      `модуле ПОО «Сетевой город. Образование». Приложение не заменяет сайт ` +
      `${host}, а даёт к нему удобный мобильный доступ.`
  },
  {
    name: schoolQuestion,
    text: schoolAnswer
  },
  {
    name: passwordQuestion,
    text: passwordAnswer
  },
  ...(region.hasEsiaOnly
    ? [
        {
          name: esiaQuestion,
          text:
            (region.note || '') +
            ' Это требование регионального оператора, не приложения.'
        }
      ]
    : []),
  {
    name: `Где официальный портал Сетевого города — ${region.name}?`,
    text:
      `Официальный адрес: ${region.url}. Дневник СПО лишь подключается к нему ` +
      `при выборе региона «${region.name}» в приложении.` +
      (cities.length
        ? ` Города, по которым часто ищут: ${cities.join(', ')}.`
        : '')
  }
]

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `https://diary-spo.github.io/${path}`,
    about: [
      'Дневник СПО',
      'неофициальное приложение',
      'Сетевой город. Образование',
      region.name,
      spoLabel
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Дневник СПО',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Android',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
    description: description
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqMain.map((item) => ({
      '@type': 'Question',
      name: item.name,
      acceptedAnswer: { '@type': 'Answer', text: item.text }
    }))
  }
]
---

<Layout
  title={title}
  description={description}
  path={path}
  ogImage={photo}
  jsonLd={jsonLd}
>
  <a class="seo-back" href={withBase('regions/')}>
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M15 6 9 12l6 6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Все регионы
  </a>

  <section
    class="region-hero"
    style={`--region-photo: url('${photo}')`}
    aria-label={region.name}
  >
    <div class="region-hero-bg" aria-hidden="true"></div>
    <div class="region-hero-in">
      <img
        class="region-hero-emblem"
        src={emblem}
        alt={`Герб: ${region.name}`}
        width="84"
        height="84"
      />
      <div>
        <p class="region-hero-kicker">
          Неофициальное приложение · {spoLabel}
        </p>
        <h1>{h1}</h1>
        <p class="region-hero-lead">
          {intro} Не сам «Сетевой город», а Android-клиент к его модулю ПОО для
          региона «{region.name}».
        </p>
      </div>
      <div class="region-hero-meta">
        <span class="region-hero-chip">код {codeLabel}</span>
        <a
          class="region-hero-chip"
          href={region.url}
          target="_blank"
          rel="noreferrer">{host}</a
        >
        {
          region.hasEsiaOnly && (
            <span class="region-hero-chip">только Госуслуги</span>
          )
        }
        {
          cities.slice(0, 3).map((city) => (
            <span class="region-hero-chip">{city}</span>
          ))
        }
      </div>
    </div>
  </section>

  <p class="seo-lead">{whatIs}</p>

  <Callout variant="warn" title="Важно: это приложение, не сам дневник">
    <p>
      Дневник СПО — неофициальный клиент. Официальный электронный дневник /
      «Сетевой город. Образование» по-прежнему на портале региона ({host}). Мы не
      выдаём пароли, не меняем оценки и не заменяем сайт оператора — только
      показываем уже доступные вам данные удобнее на телефоне.
    </p>
  </Callout>

  <Callout variant="info" title="Если искали «Сетевой город» или код региона">
    <p>
      Запросы вроде «Сетевой город {mainCity || region.name}», «электронный
      дневник СПО {codeLabel}» или «дневник СПО {codeLabel}» обычно про
      региональный портал. Если колледж на модуле ПОО этой системы — наше
      приложение может подойти как мобильный доступ к тем же данным.
    </p>
  </Callout>

  {
    region.hasEsiaOnly && (
      <Callout variant="warn" title="Важно для этого региона">
        <p>{region.note}</p>
      </Callout>
    )
  }

  <Callout variant="tip" title="Что делает приложение">
    <p>
      Показывает расписание, оценки, задания и объявления с портала {host} в
      удобном виде. Для студентов СПО{cities.length > 0 && <> из {
          cities.slice(0, 3).join(', ')
        } и других городов региона</>}. Официальный сайт при этом остаётся
      основным источником данных.
    </p>
  </Callout>

  <h2 class="seo-block-title">Как войти</h2>
  <ol class="seo-steps">
    <li class="seo-step">
      <span class="seo-step-n">1</span>
      <div>
        <h3>Выберите «{region.name}»</h3>
        <p>
          В списке регионов при первом запуске — не другой субъект с похожим
          названием.
        </p>
      </div>
    </li>
    <li class="seo-step">
      <span class="seo-step-n">2</span>
      <div>
        <h3>Логин или Госуслуги</h3>
        <p>{howToEnter}</p>
      </div>
    </li>
    <li class="seo-step">
      <span class="seo-step-n">3</span>
      <div>
        <h3>Готово</h3>
        <p>
          В приложении откроются расписание и оценки с регионального портала.
        </p>
      </div>
    </li>
  </ol>

  <Callout variant="ok" title="Пароль не хранится в приложении">
    <p>
      Данные уходят напрямую в региональный дневник. Исходный код открыт на
      GitHub.
    </p>
  </Callout>

  <h2 class="seo-block-title">Если дневник не открывается</h2>
  <div class="seo-faq">
    <div class="seo-faq-item">
      <h3>Работы на портале Сетевого города</h3>
      <p>{ifNotOpens}</p>
    </div>
    <div class="seo-faq-item">
      <h3>Неверный регион</h3>
      <p>
        Должна быть выбрана именно «{region.name}» — код {codeLabel} — иначе
        запросы уйдут на другой портал.
      </p>
    </div>
    <div class="seo-faq-item">
      <h3>Переход на ЕСИА</h3>
      <p>
        Используйте «Войти через Госуслуги». Подробнее:
        <a href={withBase('vhod-cherez-gosuslugi/')}>инструкция</a>.
      </p>
    </div>
  </div>

  <div class="seo-related">
    <a href={withBase('dnevnik-spo-ne-otkryvaetsya/')}>Не открывается</a>
    <a href={withBase('dnevnik-spo-oshibka-zaprosa/')}>Ошибка запроса</a>
    <a href={withBase('dnevnik-spo-ne-rabotaet/')}>Не работает</a>
    <a href={withBase('regions/')}>Все регионы</a>
  </div>

  <h2 class="seo-block-title">Частые вопросы</h2>
  <div class="seo-faq">
    {
      faqMain.map((item) => (
        <div class="seo-faq-item">
          <h3>{item.name}</h3>
          <p>{item.text}</p>
        </div>
      ))
    }
  </div>

  <h2 class="seo-block-title">Как ещё ищут дневник в этом регионе</h2>
  <p>
    Так обычно гуглят официальный электронный дневник / Сетевой город для «{
      region.name
    }». Дневник СПО — приложение, которое может открыть эти же данные на
    Android, если регион поддерживается:
  </p>
  <ul class="seo-search-phrases">
    {searchPhrases.map((phrase) => <li>{phrase}</li>)}
  </ul>

  <DownloadCta
    title={`Скачать приложение Дневник СПО — ${region.name}`}
    lead={`Неофициальный клиент · Android · ${spoLabel}`}
  />
</Layout>

<style>
  .seo-block-title {
    margin: 1.75rem 0 0.75rem !important;
    font-size: 1.2rem !important;
  }
</style>
