---
import RegionalPage from '../components/RegionalPage.astro'
import { REGIONS } from '../lib/regions'

export async function getStaticPaths() {
  return REGIONS.map((region) => ({
    params: { code: region.code },
    props: { region },
  }))
}

const { region } = Astro.props
---

<RegionalPage {region} />
