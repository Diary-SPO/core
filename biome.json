{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "includes": [
      "**",
      "!**/node_modules",
      "!apps/network-city",
      "!apps/api/dist",
      "!apps/admin/dist",
      "!apps/web/dist",
      "!**/bun.lockb"
    ]
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["**/package.json"],
      "json": {
        "formatter": {
          "expand": "auto"
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/build",
      "!!**/.gradle",
      "!!apps/mobile/android/app/src/main/assets/public",
      "!!apps/network-city",
      "!!**/bun.lockb"
    ],
    "maxSize": 4096000
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noParameterAssign": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "preset": "recommended"
    },
    "includes": [
      "**",
      "!**/node_modules",
      "!apps/network-city",
      "!apps/api/dist",
      "!apps/admin/dist",
      "!apps/web/dist",
      "!**/bun.lockb"
    ]
  }
}
